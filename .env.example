# LoLBench — model API keys for the Harbor agent phase.
# Copy to `.env` and fill in the key for the provider you use, or just export
# the variable in your shell before running `harbor run`.
#
# The reference setting is OpenCode + DeepSeek-V4-Pro via OpenRouter:
#   harbor run -p harbor_tasks/<id> -a opencode -m openrouter/deepseek/deepseek-v4-pro ...

# OpenRouter (reachable by default in the agent allowlist). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Native providers (also reachable by default). Use with -m <provider>/<model>.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
