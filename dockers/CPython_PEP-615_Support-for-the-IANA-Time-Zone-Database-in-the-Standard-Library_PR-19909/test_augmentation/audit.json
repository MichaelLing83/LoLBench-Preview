      ],
      "public_surface": "zoneinfo.ZoneInfo primary constructor, ZoneInfo.no_cache(), ZoneInfo.clear_cache(only_keys=...), and ZoneInfo.key through both Python and C implementation lanes.",
      "internal_symbol_check": [
        "zoneinfo._zoneinfo._*",
        "zoneinfo._common._*",
        "zoneinfo._tzpath._*",
        "_zoneinfo.*"
      ],
      "oracle_kind": "requirement-driven",
      "rationale": "PEP 615 requires identical primary-constructor calls to return the same live object, no_cache to bypass that cache, and targeted cache invalidation to remove only requested keys from every cache lane."
    },
