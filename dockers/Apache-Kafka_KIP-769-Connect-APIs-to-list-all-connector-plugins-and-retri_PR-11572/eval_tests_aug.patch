+package org.apache.kafka.connect.integration;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+import org.apache.kafka.connect.runtime.rest.entities.ConfigKeyInfo;
+import org.apache.kafka.connect.util.clusters.EmbeddedConnectCluster;
+import org.apache.kafka.test.IntegrationTest;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.experimental.categories.Category;
+import org.junit.rules.TestRule;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import java.util.stream.Collectors;
+
+import static org.apache.kafka.test.TestUtils.waitForCondition;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * KIP-769 system-level test for the new {@code GET /connector-plugins/<plugin>/config}
+ * REST endpoint (documented in the KIP's Public Interfaces / Proposed Changes sections).
+ *
+ * <p>The KIP documents that this endpoint returns the configuration definitions of the
+ * specified plugin as a list of {@code ConfigKeyInfo} objects, and "will work with all
+ * plugins returned by {@code /connector_plugins}". The KIP's worked example shows that
+ * {@code GET /connector-plugins/org.apache.kafka.connect.transforms.Cast$Value/config}
+ * returns the {@code spec} configuration key.</p>
+ *
+ * <p>This test drives the real endpoint through an embedded Connect cluster (which starts an
+ * embedded Kafka broker on localhost) and asserts the documented configuration keys are
+ * present in the returned {@code List<ConfigKeyInfo>}. It names only the documented REST
+ * resource path and the documented {@code ConfigKeyInfo} response entity; it does not name
+ * any internal source symbol introduced by the PR.</p>
+ */
+@Category(IntegrationTest.class)
+public class ConnectorPluginsConfigEndpointAugIntegrationTest {
+
+    private static final Logger log =
+            LoggerFactory.getLogger(ConnectorPluginsConfigEndpointAugIntegrationTest.class);
+
+    private static final long WORKERS_UP_TIMEOUT_MS = TimeUnit.SECONDS.toMillis(60);
+    private static final int NUM_WORKERS = 1;
+
+    // KIP worked example: a transformation that defines a "spec" config key.
+    private static final String TRANSFORMATION_PLUGIN =
+            "org.apache.kafka.connect.transforms.Cast$Value";
+    private static final String TRANSFORMATION_CONFIG_KEY = "spec";
+
+    // A converter that overrides config() with at least one key ("converter.type"), exercising
+    // the converter dispatch path of the endpoint.
+    private static final String CONVERTER_PLUGIN =
+            "org.apache.kafka.connect.converters.ByteArrayConverter";
+    private static final String CONVERTER_CONFIG_KEY = "converter.type";
+
+    // Documented lowercase "type" values for the plugin listing (KIP Public Interfaces).
+    private static final List<String> DOCUMENTED_PLUGIN_TYPES = Arrays.asList(
+            "sink", "source", "converter", "header_converter", "transformation", "predicate");
+
+    private EmbeddedConnectCluster connect;
+
+    @Rule
+    public TestRule watcher = ConnectIntegrationTestUtils.newTestWatcher(log);
+
+    @Before
+    public void setup() throws InterruptedException {
+        Map<String, String> workerProps = new HashMap<>();
+
+        Properties brokerProps = new Properties();
+        brokerProps.put("auto.create.topics.enable", "false");
+
+        connect = new EmbeddedConnectCluster.Builder()
+                .name("connector-plugins-config-cluster")
+                .numWorkers(NUM_WORKERS)
+                .numBrokers(1)
+                .workerProps(workerProps)
+                .brokerProps(brokerProps)
+                .build();
+
+        connect.start();
+        connect.assertions().assertExactlyNumWorkersAreUp(NUM_WORKERS,
+                "Initial group of workers did not start in time.");
+
+        // Wait until the REST endpoint is serving plugin listings before querying config.
+        waitForCondition(this::connectorPluginsListed, WORKERS_UP_TIMEOUT_MS,
+                "Connect REST API did not list connector plugins in time.");
+    }
+
+    @After
+    public void close() {
+        if (connect != null) {
+            connect.stop();
+        }
+    }
+
+    @Test
+    public void testTransformationConfigEndpointExposesDocumentedKey() throws Exception {
+        List<String> keyNames = configKeyNames(TRANSFORMATION_PLUGIN);
+        assertTrue("GET /connector-plugins/" + TRANSFORMATION_PLUGIN
+                        + "/config must expose the documented '" + TRANSFORMATION_CONFIG_KEY
+                        + "' key, but returned " + keyNames,
+                keyNames.contains(TRANSFORMATION_CONFIG_KEY));
+    }
+
+    @Test
+    public void testConverterConfigEndpointExposesDocumentedKey() throws Exception {
+        List<String> keyNames = configKeyNames(CONVERTER_PLUGIN);
+        assertTrue("GET /connector-plugins/" + CONVERTER_PLUGIN
+                        + "/config must expose the converter's '" + CONVERTER_CONFIG_KEY
+                        + "' key, but returned " + keyNames,
+                keyNames.contains(CONVERTER_CONFIG_KEY));
+    }
+
+    @Test
+    public void testListAllPluginsExposeDocumentedLowercaseTypes() throws Exception {
+        // The KIP documents that, with connectorsOnly=false, the "type" field of each listed
+        // plugin takes one of the lowercase values "sink", "source", "converter",
+        // "header_converter", "transformation" and "predicate".
+        String body = getBody(connect.endpointForResource("connector-plugins?connectorsOnly=false"));
+        List<Map<String, Object>> plugins =
+                new ObjectMapper().readValue(body, new TypeReference<List<Map<String, Object>>>() { });
+        Set<Object> types = plugins.stream()
+                .map(plugin -> plugin.get("type"))
+                .collect(Collectors.toSet());
+
+        for (String documentedType : DOCUMENTED_PLUGIN_TYPES) {
+            assertTrue("GET /connector-plugins?connectorsOnly=false must report the documented "
+                            + "lowercase plugin type '" + documentedType + "', but reported " + types,
+                    types.contains(documentedType));
+        }
+    }
+
+    private boolean connectorPluginsListed() {
+        try {
+            String body = getBody(
+                    connect.endpointForResource("connector-plugins?connectorsOnly=false"));
+            return body != null && body.contains("\"class\"");
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    /** Issue {@code GET /connector-plugins/<plugin>/config} and return the configuration key names. */
+    private List<String> configKeyNames(String plugin) throws Exception {
+        String body = getBody(connect.endpointForResource("connector-plugins/" + plugin + "/config"));
+        List<ConfigKeyInfo> configKeys =
+                new ObjectMapper().readValue(body, new TypeReference<List<ConfigKeyInfo>>() { });
+        return configKeys.stream().map(ConfigKeyInfo::name).collect(Collectors.toList());
+    }
+
+    /** GET the given URL and return its response body. */
+    private String getBody(String url) {
+        return (String) connect.requestGet(url).getEntity();
+    }
+}
