+package org.apache.kafka.connect.runtime.rest.resources;
+
+import org.junit.Test;
+
+import javax.ws.rs.DefaultValue;
+import java.lang.reflect.Method;
+
+import static org.junit.Assert.assertEquals;
+
+/**
+ * KIP-769 documents that the {@code GET /connector-plugins} listing endpoint gains a
+ * {@code connectorsOnly} query parameter that "defaults to {@code true} so it's fully
+ * compatible with the current behavior".
+ *
+ * <p>This test asserts the documented default ("true") of the documented
+ * {@code listConnectorPlugins} query parameter on the documented {@code ConnectorPluginsResource}.
+ * It names only documented public-surface concepts and the JAX-RS {@code @DefaultValue}
+ * annotation; it does not name any internal source symbol introduced by the PR.</p>
+ */
+public class ConnectorPluginsListDefaultAugTest {
+
+    @Test
+    public void testConnectorsOnlyQueryParamDefaultsToTrue() throws Exception {
+        Method method = ConnectorPluginsResource.class.getMethod("listConnectorPlugins", boolean.class);
+        DefaultValue defaultValue = method.getParameters()[0].getAnnotation(DefaultValue.class);
+
+        assertEquals("true", defaultValue.value());
+    }
+}
