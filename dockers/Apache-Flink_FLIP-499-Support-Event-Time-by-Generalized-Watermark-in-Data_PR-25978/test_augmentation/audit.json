  "equivalent_mutants": {
    "mutant_007_handler_does_not_wait_all_inputs": {
      "requirement_sections": [
        "Event Time Watermark Definition"
      ],
      "reason": "The mutation removes the explicit hasReceiveWatermarks cardinality guard in EventTimeWatermarkHandler, but unreported active inputs retain Long.MIN_VALUE event time, so public processWatermark/DataStream flows still cannot advance early. Idle-status inputs mark the channel as received in both golden and mutant paths. The union suite therefore observes identical F2P/P2P behavior."
    },
    "mutant_029_process_operator_forwards_extension_watermarks_directly": {
      "requirement_sections": [
        "Handle watermarks by user-defined ProcessFunction"
      ],
      "reason": "The mutation forwards extension watermarks after PEEK handling, but downstream public ProcessFunction/EventTimeProcessFunction paths still receive an EventTimeWatermark carrying the same identifier/value and process it through the same public extension predicates. No allowed system-level oracle distinguishes the raw-forwarded watermark from the framework-emitted one without private operator-state inspection."
    }
