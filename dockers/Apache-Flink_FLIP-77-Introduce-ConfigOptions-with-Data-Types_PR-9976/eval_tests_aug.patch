+package org.apache.flink.configuration;
+
+import org.junit.Test;
+
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+
+import static org.hamcrest.CoreMatchers.equalTo;
+import static org.hamcrest.CoreMatchers.instanceOf;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertThat;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+/**
+ * LoLBench augmentation tests for FLIP-77 typed configuration options.
+ *
+ * <p>Public API only: ConfigOptions, ConfigOption, and Configuration. This file
+ * intentionally does not call package-private parsing helpers.
+ */
+public class ConfigurationTypedOptionsAugTest {
+
+	@Test
+	public void testTypedRawStringConversionsForDocumentedAtomicTypes() {
+		Configuration configuration = new Configuration();
+
+		ConfigOption<Integer> intOption = ConfigOptions.key("aug.int")
+			.intType()
+			.noDefaultValue();
+		ConfigOption<Boolean> booleanOption = ConfigOptions.key("aug.boolean")
+			.booleanType()
+			.noDefaultValue();
+		ConfigOption<Duration> durationOption = ConfigOptions.key("aug.duration")
+			.durationType()
+			.noDefaultValue();
+		ConfigOption<MemorySize> memoryOption = ConfigOptions.key("aug.memory")
+			.memoryType()
+			.noDefaultValue();
+		ConfigOption<Map<String, String>> mapOption = ConfigOptions.key("aug.properties")
+			.mapType()
+			.noDefaultValue();
+
+		configuration.setString(intOption.key(), "5");
+		configuration.setString(booleanOption.key(), "false");
+		configuration.setString(durationOption.key(), "20ms");
+		configuration.setString(memoryOption.key(), "16mb");
+		configuration.setString(mapOption.key(), "left:one,right:two");
+
+		Integer intValue = configuration.get(intOption);
+		Boolean booleanValue = configuration.get(booleanOption);
+		Duration durationValue = configuration.get(durationOption);
+		MemorySize memoryValue = configuration.get(memoryOption);
+		Map<String, String> mapValue = configuration.get(mapOption);
+
+		assertThat(intValue, instanceOf(Integer.class));
+		assertEquals(Integer.valueOf(5), intValue);
+		assertThat(booleanValue, instanceOf(Boolean.class));
+		assertEquals(Boolean.FALSE, booleanValue);
+		assertEquals(Duration.ofMillis(20), durationValue);
+		assertEquals(new MemorySize(16L * 1024L * 1024L), memoryValue);
+		assertEquals("one", mapValue.get("left"));
+		assertEquals("two", mapValue.get("right"));
+
+		configuration.setString(booleanOption.key(), "maybe");
+		expectParseFailure(() -> configuration.get(booleanOption), "maybe");
+	}
+
+	@Test
+	public void testListParsingUsesSemicolonEscapingAndPreservesEmptyElements() {
+		Configuration configuration = new Configuration();
+		ConfigOption<List<String>> option = ConfigOptions.key("aug.paths")
+			.stringType()
+			.asList()
+			.noDefaultValue();
+
+		configuration.setString(option.key(), "alpha;;'beta;gamma';\" spaced value \"");
+
+		List<String> parsed = configuration.get(option);
+		assertThat(parsed, equalTo(Arrays.asList(
+			"alpha",
+			"",
+			"beta;gamma",
+			" spaced value ")));
+	}
+
+	@Test
+	public void testMalformedQuotedListValueIsRejectedThroughConfiguration() {
+		Configuration configuration = new Configuration();
+		ConfigOption<List<String>> option = ConfigOptions.key("aug.invalid.paths")
+			.stringType()
+			.asList()
+			.noDefaultValue();
+
+		configuration.setString(option.key(), "'a'b;c");
+
+		expectParseFailure(() -> configuration.get(option), option.key());
+	}
+
+	@Test
+	public void testMapParsingUsesCommaEntriesAndColonPairs() {
+		Configuration configuration = new Configuration();
+		ConfigOption<Map<String, String>> option = ConfigOptions.key("aug.map")
+			.mapType()
+			.noDefaultValue();
+
+		configuration.setString(option.key(), "k1:v1,k2:v2");
+
+		Map<String, String> parsed = configuration.get(option);
+		assertEquals(2, parsed.size());
+		assertEquals("v1", parsed.get("k1"));
+		assertEquals("v2", parsed.get("k2"));
+	}
+
+	@Test
+	public void testTypedSetDefaultAndFallbackKeySemantics() {
+		Configuration configuration = new Configuration();
+		ConfigOption<Integer> defaulted = ConfigOptions.key("aug.defaulted")
+			.intType()
+			.defaultValue(77);
+		ConfigOption<Integer> roundTrip = ConfigOptions.key("aug.roundtrip")
+			.intType()
+			.defaultValue(-1);
+
+		assertEquals(Integer.valueOf(77), configuration.get(defaulted));
+		configuration.set(roundTrip, 7);
+		assertEquals(Integer.valueOf(7), configuration.get(roundTrip));
+
+		ConfigOption<Integer> fallbackOption = ConfigOptions.key("aug.current")
+			.intType()
+			.noDefaultValue()
+			.withFallbackKeys("aug.legacy");
+		Configuration fallbackConfiguration = new Configuration();
+		fallbackConfiguration.setInteger("aug.legacy", 42);
+
+		Optional<Integer> fallbackValue = fallbackConfiguration.getOptional(fallbackOption);
+		assertTrue(fallbackValue.isPresent());
+		assertEquals(Integer.valueOf(42), fallbackValue.get());
+	}
+
+	private static void expectParseFailure(ThrowingRunnable runnable, String expectedMessagePart) {
+		try {
+			runnable.run();
+			fail("Expected IllegalArgumentException");
+		} catch (IllegalArgumentException e) {
+			assertTrue(
+				"Expected message to contain '" + expectedMessagePart + "' but was: " + e.getMessage(),
+				e.getMessage().contains(expectedMessagePart));
+		}
+	}
+
+	private interface ThrowingRunnable {
+		void run();
+	}
+}
