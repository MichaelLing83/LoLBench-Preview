+package org.apache.flink.client;
+
+import org.apache.flink.configuration.Configuration;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+
+/**
+ * LoLBench augmentation tests for FLIP-77's compatibility clause: existing
+ * configuration options and legacy Configuration accessors keep their behavior.
+ */
+public class ConfigurationCompatibilityAugTest {
+
+	@Test
+	public void testLegacyPrimitiveAccessorsAndDefaultsRemainUnchanged() {
+		Configuration configuration = new Configuration();
+
+		assertEquals("fallback", configuration.getString("missing.string", "fallback"));
+		assertEquals(11, configuration.getInteger("missing.int", 11));
+		assertEquals(12L, configuration.getLong("missing.long", 12L));
+		assertEquals(false, configuration.getBoolean("missing.boolean", false));
+
+		configuration.setString("name", "flink");
+		configuration.setInteger("parallelism", 4);
+		configuration.setLong("timeout", 99L);
+		configuration.setBoolean("enabled", true);
+
+		assertEquals("flink", configuration.getString("name", ""));
+		assertEquals(4, configuration.getInteger("parallelism", 0));
+		assertEquals(99L, configuration.getLong("timeout", 0L));
+		assertEquals(true, configuration.getBoolean("enabled", false));
+		assertEquals("4", configuration.getString("parallelism", "0"));
+		assertEquals("true", configuration.getString("enabled", "false"));
+	}
+
+	@Test
+	public void testCopyConstructorAndPrefixedAddAllKeepExistingEntries() {
+		Configuration original = new Configuration();
+		original.setString("host", "localhost");
+		original.setInteger("port", 6123);
+
+		Configuration copy = new Configuration(original);
+		assertEquals("localhost", copy.getString("host", ""));
+		assertEquals(6123, copy.getInteger("port", 0));
+
+		Configuration prefixed = new Configuration();
+		prefixed.addAll(original, "client.");
+		assertEquals("localhost", prefixed.getString("client.host", ""));
+		assertEquals(6123, prefixed.getInteger("client.port", 0));
+	}
+
+	@Test
+	public void testByteArrayAndClassAccessorsRemainCompatible() throws Exception {
+		Configuration configuration = new Configuration();
+		byte[] payload = new byte[] {1, 2, 3, 5, 8};
+
+		configuration.setBytes("payload", payload);
+		configuration.setString("class.name", ConfigurationCompatibilityAugTest.class.getName());
+
+		assertArrayEquals(payload, configuration.getBytes("payload", new byte[0]));
+		assertArrayEquals(new byte[] {9}, configuration.getBytes("missing.payload", new byte[] {9}));
+		assertEquals(
+			ConfigurationCompatibilityAugTest.class,
+			configuration.getClass(
+				"class.name",
+				Object.class,
+				ConfigurationCompatibilityAugTest.class.getClassLoader()));
+		assertEquals(
+			Object.class,
+			configuration.getClass(
+				"missing.class",
+				Object.class,
+				ConfigurationCompatibilityAugTest.class.getClassLoader()));
+
+		Configuration copied = new Configuration(configuration);
+		assertArrayEquals(
+			new byte[] {1, 2, 3, 5, 8},
+			copied.getBytes("payload", new byte[0]));
+	}
+}
