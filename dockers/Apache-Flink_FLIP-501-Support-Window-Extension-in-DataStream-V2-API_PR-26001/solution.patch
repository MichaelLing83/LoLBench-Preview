+                windowState.setCurrentNamespace(stateWindow);
+                outputCollector.setTimestamp(window.maxTimestamp());
+                windowFunctionContext.setWindow(window);
+                windowProcessFunction.onRecord(
+                        element.getValue(),
+                        outputCollector,
+                        partitionedContext,
+                        windowFunctionContext);
+
