+package org.apache.flink.table.planner.codegen;
+
+import org.apache.flink.configuration.Configuration;
+import org.apache.flink.table.annotation.DataTypeHint;
+import org.apache.flink.table.annotation.FunctionHint;
+import org.apache.flink.table.api.DataTypes;
+import org.apache.flink.table.data.StringData;
+import org.apache.flink.table.functions.AsyncTableFunction;
+import org.apache.flink.table.planner.codegen.calls.BridgingFunctionGenUtil$;
+import org.apache.flink.table.types.extraction.TypeInferenceExtractor;
+import org.apache.flink.table.types.inference.TypeInference;
+import org.apache.flink.table.types.inference.utils.CallContextMock;
+import org.apache.flink.table.types.logical.IntType;
+import org.apache.flink.table.types.logical.RowType;
+import org.apache.flink.table.types.logical.VarCharType;
+import org.apache.flink.table.types.utils.DataTypeFactoryMock;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.Collections;
+import java.util.Optional;
+import java.util.concurrent.CompletableFuture;
+
+import scala.Option;
+import scala.collection.JavaConverters;
+import scala.collection.Seq;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/** Additional code-generation coverage for async table logical return typing. */
+public class AsyncCorrelateCodeGeneratorAugTest {
+
+    @Test
+    public void testAtomicAsyncTableGeneratedExpressionKeepsLogicalRowType() {
+        final DataTypeFactoryMock dataTypeFactory = new DataTypeFactoryMock();
+        final AtomicInternalStringFunction udf = new AtomicInternalStringFunction();
+        final RowType returnType = RowType.of(VarCharType.STRING_TYPE);
+        final GeneratedExpression operand =
+                new GeneratedExpression("42", "false", "", new IntType(false), Option.empty());
+        final Seq<GeneratedExpression> operands =
+                JavaConverters.asScalaBufferConverter(Collections.singletonList(operand))
+                        .asScala()
+                        .toSeq();
+        final TypeInference typeInference =
+                TypeInferenceExtractor.forAsyncTableFunction(
+                        dataTypeFactory, AtomicInternalStringFunction.class);
+        final CallContextMock callContext = new CallContextMock();
+        callContext.typeFactory = dataTypeFactory;
+        callContext.argumentDataTypes = Collections.singletonList(DataTypes.INT().notNull());
+        callContext.argumentLiterals = Collections.singletonList(false);
+        callContext.argumentNulls = Collections.singletonList(false);
+        callContext.argumentValues = Collections.singletonList(Optional.empty());
+        callContext.functionDefinition = udf;
+        callContext.name = "atomicInternal";
+        callContext.outputDataType = Optional.empty();
+        callContext.isGroupedAggregation = false;
+        final CodeGeneratorContext context =
+                new CodeGeneratorContext(
+                        new Configuration(), Thread.currentThread().getContextClassLoader());
+
+        final GeneratedExpression generated =
+                BridgingFunctionGenUtil$.MODULE$.generateFunctionAwareCall(
+                        context,
+                        operands,
+                        returnType,
+                        typeInference,
+                        callContext,
+                        udf,
+                        "eval",
+                        false);
+
+        assertThat(generated.resultType()).isEqualTo(returnType);
+    }
+
+    /** Atomic output bridged to Flink's internal string representation. */
+    @FunctionHint(output = @DataTypeHint(value = "STRING", bridgedTo = StringData.class))
+    public static class AtomicInternalStringFunction extends AsyncTableFunction<StringData> {
+
+        public void eval(CompletableFuture<java.util.Collection<StringData>> future, int value) {
+            future.complete(
+                    Collections.singletonList(StringData.fromString("internal " + value)));
+        }
+    }
+}
