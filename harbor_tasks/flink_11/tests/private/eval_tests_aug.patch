+package org.apache.flink.client.cli;
+
+import org.apache.flink.configuration.Configuration;
+import org.apache.flink.configuration.CoreOptions;
+import org.apache.flink.configuration.DeploymentOptions;
+
+import org.apache.commons.cli.CommandLine;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/** Additional regression coverage for unchanged flink-clients CLI option behavior. */
+class ClientCliAugTest {
+
+    @Test
+    void testRunOptionsPreserveAttachedShutdownAndProgramArgs() throws Exception {
+        String[] parameters = {"-sae", "-p", "3", "job.jar", "arg1", "arg2"};
+
+        CommandLine commandLine =
+                CliFrontendParser.parse(CliFrontendParser.RUN_OPTIONS, parameters, true);
+        ProgramOptions programOptions = ProgramOptions.create(commandLine);
+        Configuration configuration = new Configuration();
+        programOptions.applyToConfiguration(configuration);
+
+        assertThat(programOptions.getJarFilePath()).isEqualTo("job.jar");
+        assertThat(programOptions.getProgramArgs()).containsExactly("arg1", "arg2");
+        assertThat(programOptions.getDetachedMode()).isFalse();
+        assertThat(programOptions.isShutdownOnAttachedExit()).isTrue();
+        assertThat(configuration.get(CoreOptions.DEFAULT_PARALLELISM)).isEqualTo(3);
+        assertThat(configuration.get(DeploymentOptions.ATTACHED)).isTrue();
+        assertThat(configuration.get(DeploymentOptions.SHUTDOWN_IF_ATTACHED)).isTrue();
+    }
+
+    @Test
+    void testDetachedRunOptionKeepsShutdownFlagIndependent() throws Exception {
+        String[] parameters = {"-d", "-sae", "job.jar"};
+
+        CommandLine commandLine =
+                CliFrontendParser.parse(CliFrontendParser.RUN_OPTIONS, parameters, true);
+        ProgramOptions programOptions = ProgramOptions.create(commandLine);
+        Configuration configuration = new Configuration();
+        programOptions.applyToConfiguration(configuration);
+
+        assertThat(programOptions.getJarFilePath()).isEqualTo("job.jar");
+        assertThat(programOptions.getDetachedMode()).isTrue();
+        assertThat(programOptions.isShutdownOnAttachedExit()).isTrue();
+        assertThat(configuration.get(DeploymentOptions.ATTACHED)).isFalse();
+        assertThat(configuration.get(DeploymentOptions.SHUTDOWN_IF_ATTACHED)).isTrue();
+    }
+}
