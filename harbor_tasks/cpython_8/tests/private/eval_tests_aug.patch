+import calendar
+import string
+import unittest
+
+
+class Pep701UnchangedPublicSurfaceAugTests(unittest.TestCase):
+    def test_string_formatter_nested_lookup_and_conversion_remain_stable(self):
+        formatter = string.Formatter()
+        rendered = formatter.format("{name!r:^10} -> {point[0]:03d}/{point[1]:03d}", name="x", point=(7, 42))
+        self.assertEqual(rendered, "   'x'     -> 007/042")
+        self.assertEqual("{0.real:.1f}+{0.imag:.1f}j".format(3 + 4j), "3.0+4.0j")
+
+    def test_template_substitution_and_escaping_remain_stable(self):
+        template = string.Template("$kind:${name}:$$${amount}")
+        self.assertEqual(template.substitute(kind="item", name="alpha", amount="9"), "item:alpha:$9")
+        self.assertEqual(template.safe_substitute(kind="item"), "item:${name}:$${amount}")
+
+    def test_calendar_formatting_and_weekday_errors_remain_stable(self):
+        cal = calendar.TextCalendar(firstweekday=calendar.SUNDAY)
+        self.assertEqual(cal.formatweekheader(2), "Su Mo Tu We Th Fr Sa")
+        self.assertTrue(calendar.isleap(2000))
+        self.assertFalse(calendar.isleap(1900))
+        with self.assertRaises(calendar.IllegalWeekdayError):
+            calendar.setfirstweekday(9)
